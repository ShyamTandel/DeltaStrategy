# Django Configuration
SECRET_KEY=your-secret-key-here-generate-a-strong-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=deltadb
DB_USER=deltauser
DB_PASSWORD=your-strong-password-here
DB_HOST=mysql
DB_PORT=3306

# MySQL Root Password (for docker-compose)
MYSQL_ROOT_PASSWORD=your-root-password-here
MYSQL_DATABASE=deltadb
MYSQL_USER=deltauser
MYSQL_PASSWORD=your-strong-password-here

# Redis & Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0

# Delta Exchange API Credentials
DELTA_API_KEY=your-delta-api-key
DELTA_API_SECRET=your-delta-api-secret
DELTA_API_BASE=https://api.delta.exchange

# Django Superuser (Optional - for initial setup)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@yourdomain.com
DJANGO_SUPERUSER_PASSWORD=your-admin-password

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# For production, set these to True when using HTTPS:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
